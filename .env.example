# ==============================================================================
# TrustLance Frontend Environment Variables (.env.local)
# MST Blockchain Buildathon #2 Configuration
# ==============================================================================

# Supabase Configuration
# For local development with Supabase CLI:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# MST Testnet Configuration
# Chain ID: 91562037 (Hex: 0x5752035) | Native Currency: tMSTC | Decimals: 18
VITE_CHAIN_ID=91562037
VITE_RPC_URL=https://testnetrpc.mstblockchain.com

# Deployed TrustLanceFactory Address on MST Testnet
# Fill this in after running `npx hardhat run scripts/deploy.ts --network mstTestnet`
VITE_TRUSTLANCE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional Pinata IPFS Configuration (for milestone deliverable verification)
# VITE_PINATA_JWT=your_pinata_jwt_here
# VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
